---
/**
 * Homepage alleggerita: presenta, non esaurisce. Ogni sezione rimanda
 * alla sua pagina dedicata (/servizi, /chi-siamo, /team, /sedi, /news,
 * /mentoria) come nel sito di riferimento.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Manifesto from '../components/sections/Manifesto.astro';
import ServicesGrid from '../components/sections/ServicesGrid.astro';
import MentoriaBand from '../components/sections/MentoriaBand.astro';
import Locations from '../components/sections/Locations.astro';
import NewsTeaser from '../components/sections/NewsTeaser.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import DecoBand from '../components/DecoBand.astro';
import { site } from '../data/site';
import { locations } from '../data/locations';
---

<BaseLayout theme="light">
  <Hero
    eyebrow="Metodo · Riservatezza · Risultati"
    video="/video/hero-1.mp4"
    lead="Dal 1989 affianchiamo imprenditori e famiglie d'impresa: compravendita di aziende, finanza straordinaria, passaggio generazionale. Presenza diffusa tra Europa e Golfo, per progetti in tutto il mondo."
    ctas={[
      { label: 'Richiedi un incontro riservato', href: '/contatti/', solid: true },
      { label: 'Scopri i servizi', href: '/servizi/' },
    ]}
    meta={[
      { value: String(site.foundedYear), label: 'Anno di fondazione' },
      { label: 'Presenza diffusa tra Europa e Golfo' },
      { value: '360°', label: 'Strategia · Finanza · Tutela' },
    ]}
  >
    <Fragment slot="title">Advisor per le<br /><em>operazioni straordinarie</em></Fragment>
  </Hero>

  <Manifesto
    eyebrow="Chi siamo"
    sign="Fulvio Tancredi Rossi — Presidente e Co-fondatore"
    signPhoto="/images/team/fulvio-rossi.jpg"
    ctaLabel="Scopri lo studio"
    ctaHref="/chi-siamo/"
  >
    Facciamo da tramite per comprare e vendere aziende, e troviamo acquirenti
    nelle operazioni di ristrutturazione. Attorno a questo, un
    <em>Think Tank</em> multidisciplinare: un bacino di competenze che affianca
    la vostra impresa e costruisce con voi una business strategy su misura.
  </Manifesto>

  <ServicesGrid />

  <MentoriaBand />

  <Locations compact={true} />

  <NewsTeaser />

  <DecoBand />

  <CtaBand
    lead="Un confronto riservato, senza impegno: mettiamo a fuoco insieme il valore da liberare e le mosse da fare."
  >
    <Fragment slot="title">Pronti a incontrare<br />i vostri <em>advisor?</em></Fragment>
  </CtaBand>
</BaseLayout>
