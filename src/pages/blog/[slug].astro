---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import { getPosts, formatDate, type Post } from '../../lib/wp';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: Post;
}
const { post } = Astro.props;
const dateLabel = `${formatDate(post.date)}${post.author ? ` · ${post.author}` : ''}`;

// Il titolo di un articolo è già lungo: aggiungiamo il brand solo se il tag
// <title> resta entro i ~60 caratteri utili in SERP.
const withBrand = `${post.title} · Fulvio Rossi Plus`;
const pageTitle = withBrand.length <= 60 ? withBrand : post.title;
---

<BaseLayout
  theme="light"
  title={pageTitle}
  description={post.metaDescription ?? post.excerpt}
  ogImage={post.featuredImage?.url}
>
  <article>
    <PageHero eyebrow={dateLabel} photo={post.featuredImage?.url} art="editorial">
      {post.title}
    </PageHero>

    <div class="wrap">
      <div class="post-content" data-reveal set:html={post.contentHtml} />
    </div>
  </article>

  <CtaBand
    lead="Un confronto riservato per mettere a fuoco insieme il valore da liberare e le mosse da fare."
  >
    <Fragment slot="title">Pronti a incontrare<br />i vostri <em>advisor?</em></Fragment>
  </CtaBand>
</BaseLayout>

<style>
  .post-content {
    max-width: 720px;
    padding: 70px 0 100px;
  }
  .post-content :global(p) {
    font-size: 20px; line-height: 1.75; color: var(--ink-dim);
    margin-bottom: 26px;
  }
  .post-content :global(h2) { font-size: 32px; margin: 46px 0 18px; }
  .post-content :global(h3) { font-size: 25px; margin: 38px 0 14px; }
  .post-content :global(a) {
    color: var(--accent-text);
    border-bottom: 1px solid var(--hair);
  }
  .post-content :global(blockquote) {
    font-family: var(--disp); font-size: 25px;
    line-height: 1.45; color: var(--ink);
    border-left: 2px solid var(--accent);
    padding-left: 26px; margin: 38px 0;
  }
  .post-content :global(ul), .post-content :global(ol) { padding-left: 24px; margin-bottom: 26px; }
  .post-content :global(li) { font-size: 19px; line-height: 1.7; color: var(--ink-dim); margin-bottom: 8px; }
  .post-content :global(img) {
    border: 1px solid var(--hair-faint);
    margin: 30px 0;
    max-width: 100%; height: auto;
  }

  /* Figure del corpo: immagine centrata nella colonna, didascalia a filo.
     La larghezza massima arriva inline, per non ingrandire oltre il nativo
     i materiali d'archivio a bassa risoluzione. */
  .post-content :global(.post-fig) { margin: 42px auto; }
  .post-content :global(.post-fig img) { display: block; width: 100%; margin: 0; }
  .post-content :global(.post-fig figcaption) {
    font-family: var(--sans);
    font-size: 14px; line-height: 1.55;
    color: var(--muted);
    margin-top: 12px; padding-left: 14px;
    border-left: 2px solid var(--accent);
  }
  .post-content :global(blockquote em) {
    display: inline-block; margin-top: 10px;
    font-family: var(--sans); font-size: 14px;
    font-style: normal; letter-spacing: 0.02em;
    color: var(--muted);
  }

  @media (max-width: 560px) {
    .post-content { padding: 44px 0 64px; }
    .post-content :global(p) { font-size: 17px; line-height: 1.7; margin-bottom: 20px; }
    .post-content :global(li) { font-size: 16.5px; }
    .post-content :global(h2) { font-size: 23px; margin: 34px 0 14px; }
    .post-content :global(h3) { font-size: 19px; margin: 28px 0 10px; }
    .post-content :global(blockquote) { font-size: 20px; padding-left: 18px; margin: 28px 0; }
    .post-content :global(.post-fig) { margin: 30px auto; }
    .post-content :global(.post-fig figcaption) { font-size: 13px; }
  }
</style>
