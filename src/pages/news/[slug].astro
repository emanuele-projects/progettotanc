---
/**
 * La sezione News è diventata Blog. Manteniamo i vecchi indirizzi come
 * reindirizzamento per non rompere i link già in circolazione.
 * `getStaticPaths` genera una pagina di rinvio per ogni articolo.
 */
import { getPosts } from '../../lib/wp';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.slug } }));
}

const target = url(`/blog/${Astro.params.slug}/`);
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex" />
    <title>Blog · Fulvio Rossi Plus</title>
  </head>
  <body>
    <p>Questo articolo si trova ora nel <a href={target}>Blog</a>.</p>
  </body>
</html>
