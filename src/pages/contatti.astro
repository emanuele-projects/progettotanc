---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
import { locations, typeLabels } from '../data/locations';
---

<BaseLayout
  theme="light"
  title="Contatti · Fulvio Rossi Plus"
  description="Richiedi un incontro riservato: un primo confronto per mettere a fuoco il valore da liberare e le mosse da fare."
>
  <PageHero
    eyebrow="Il primo passo"
    photo="/images/sezioni/firma.jpg" focus="52% 34%"
    lead="Raccontateci la vostra impresa: rispondiamo entro due giorni lavorativi e, se possiamo esservi utili, fissiamo un primo colloquio senza impegno."
  >
    Un incontro <em>riservato</em>
  </PageHero>

  <section class="contact-body">
    <div class="wrap contact-cols">
      <!--
        Form statico: l'hosting non ha backend per ora.
        TODO-CONTENUTO: collegare a un form service (Web3Forms/Formspree)
        o a un endpoint del futuro WordPress. Per ora: mailto.
      -->
      <form class="c-form" id="c-form" action={`mailto:${site.email}`} method="post" data-reveal>
        <div class="field">
          <label for="f-nome">Nome e cognome</label>
          <input id="f-nome" name="nome" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="f-azienda">Azienda</label>
          <input id="f-azienda" name="azienda" type="text" autocomplete="organization" />
        </div>
        <div class="field">
          <label for="f-email">Email</label>
          <input id="f-email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="f-msg">Di che cosa avete bisogno?</label>
          <textarea id="f-msg" name="messaggio" rows="6" required></textarea>
        </div>
        <p class="privacy-note">
          Inviando il modulo si apre il vostro programma di posta con il messaggio
          già scritto, indirizzato a <a href={`mailto:${site.email}`}>{site.email}</a>.
          Ogni richiesta è trattata con riservatezza assoluta.
        </p>
        <button type="submit" class="btn btn-solid">Invia la richiesta</button>
      </form>

      <aside class="c-side" data-reveal>
        <div class="c-block">
          <h4>Contatti diretti</h4>
          <p>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </p>
          <ul class="c-phones">
            {site.phones.map((p) => (
              <li>
                <span class="c-city">{p.area}</span>
                <a class="c-addr" href={`tel:${p.tel}`}>{p.number}</a>
              </li>
            ))}
          </ul>
        </div>
        <div class="c-block">
          <h4>Le nostre sedi</h4>
          <ul class="c-addresses">
            {locations.map((l) => (
              <li class:list={{ primary: l.primary }}>
                <span class="c-city">{l.city}<i>{l.cc}</i></span>
                <span class="c-role">{typeLabels[l.type]}</span>
                <span class="c-addr">{l.address.slice(0, l.address.lastIndexOf(', '))}</span>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ dest: site.email }}>
  // Il modulo non ha backend: compone il messaggio e lo consegna al client di
  // posta dell'utente. Senza JS il modulo resta comunque inviabile a mano
  // attraverso l'indirizzo in chiaro sotto i campi.
  document.getElementById('c-form')?.addEventListener('submit', (ev) => {
    ev.preventDefault();
    const f = ev.currentTarget;
    const v = (n) => (f.elements[n]?.value || '').trim();
    const oggetto = `Richiesta di contatto${v('azienda') ? ' — ' + v('azienda') : ''}`;
    const corpo = [
      `Nome e cognome: ${v('nome')}`,
      `Azienda: ${v('azienda') || '—'}`,
      `Email: ${v('email')}`,
      '',
      v('messaggio'),
    ].join('\n');
    window.location.href =
      `mailto:${dest}?subject=${encodeURIComponent(oggetto)}&body=${encodeURIComponent(corpo)}`;
  });
</script>

<style>
  .contact-body { padding: 80px 0 110px; }
  .contact-cols {
    display: grid; grid-template-columns: 1.4fr 1fr; gap: 80px;
    align-items: start;
  }

  .c-form { max-width: 620px; }
  .field { margin-bottom: 26px; }
  .field label {
    display: block;
    font-family: var(--sans); font-size: 12px; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent-text);
    margin-bottom: 10px;
  }
  .field input, .field textarea {
    width: 100%;
    background: var(--panel);
    border: 1px solid var(--hair-faint);
    color: var(--ink);
    font-family: var(--body); font-size: 17px;
    padding: 14px 16px;
    border-radius: var(--radius-card);
    transition: border-color 0.3s ease;
  }
  .field input:focus, .field textarea:focus {
    outline: none;
    border-color: var(--accent);
  }
  .privacy-note {
    font-size: 15px; color: var(--muted); margin: 6px 0 28px; max-width: 480px;
  }

  .c-side { border-left: 1px solid var(--hair); padding-left: 44px; }
  .c-block { margin-bottom: 38px; }
  .c-block h4 {
    font-family: var(--sans); font-size: 12px; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent-text);
    margin-bottom: 12px;
  }
  .c-block p { color: var(--ink-dim); font-size: 17.5px; line-height: 1.8; }
  .c-addresses, .c-phones { list-style: none; }
  .c-phones { margin-top: 12px; }
  .c-phones li { margin-bottom: 12px; }
  .c-phones a.c-addr:hover { color: var(--accent-text); }
  .c-addresses li { margin-bottom: 14px; }
  .c-city {
    display: block;
    font-family: var(--sans); font-size: 11px; font-weight: 700;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted-2);
  }
  .c-addr { display: block; color: var(--ink-dim); font-size: 16.5px; line-height: 1.5; margin-top: 3px; }

  /* Sedi: la stessa gerarchia della pagina Team & Sedi, città in carattere da
     display con la sigla del paese, poi il ruolo, poi la via. */
  .c-addresses li { margin-bottom: 18px; }
  .c-addresses .c-city {
    font-family: var(--disp); font-size: 18px; font-weight: 700;
    letter-spacing: 0; text-transform: none; color: var(--ink);
  }
  .c-addresses .c-city i {
    font-style: normal; font-family: var(--sans);
    font-size: 10px; font-weight: 700; letter-spacing: 0.14em;
    color: var(--muted-2); margin-left: 8px; vertical-align: 2px;
  }
  .c-addresses li.primary .c-city::after {
    content: "◆"; font-size: 8px; color: var(--accent); margin-left: 8px; vertical-align: 3px;
  }
  .c-role {
    display: block; font-family: var(--sans);
    font-size: 10px; font-weight: 700; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--accent-text); margin-top: 4px;
  }
  .c-addresses .c-addr { font-size: 15px; color: var(--muted); margin-top: 4px; }
  .c-block a:hover { color: var(--accent-text); }

  @media (max-width: 900px) {
    .contact-cols { grid-template-columns: 1fr; gap: 50px; }
    .c-side { border-left: none; padding-left: 0; border-top: 1px solid var(--hair); padding-top: 40px; }
  }
</style>
