---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import BrandArt from '../components/BrandArt.astro';
import Locations from '../components/sections/Locations.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import { url } from '../lib/url';
import { hasPublicAsset } from '../lib/assets';
import { team } from '../data/team';
---

<BaseLayout
  theme="light"
  title="Team & Sedi · Fulvio Rossi Plus"
  description="Le persone che vi seguono e i luoghi da cui operiamo: una guida riconoscibile e una rete di professionisti che si compone attorno alla vostra operazione."
>
  <PageHero
    eyebrow="Persone & presenza"
    photo="/images/sezioni/team.jpg" focus="50% 36%"
    lead="La fiducia nasce dai volti e dalla vicinanza. Una guida riconoscibile, una rete di professionisti alle spalle e sedi con ruoli distinti, sotto un'unica regìa."
  >
    Le persone e i <em>luoghi</em>
  </PageHero>

  <!-- TEAM: elenco unico, ordinato per ruolo -->
  <section class="team-lead">
    <div class="wrap">
      <div class="tl-head" data-reveal>
        <span class="eyebrow">Lo studio</span>
        <h2>Chi risponde di voi</h2>
        <p>
          Le stesse persone dall'inizio alla fine: è a loro che rispondete, ed è
          di voi che rispondono. Competenze ed esperienze diverse, che ampliano
          ciò che possiamo seguire senza spezzare la regìa. È il Think Tank nella
          sua forma stabile.
        </p>
      </div>

      <div class="lead-grid">
        {team.map((m) => (
          <article class="member" data-reveal>
            <div class="member-photo">
              {m.photo && hasPublicAsset(m.photo) ? (
                <img src={url(m.photo)} alt={`${m.name}, ${m.role}`} loading="lazy" />
              ) : (
                <BrandArt variant="portrait" ratio="4 / 5" label={m.mono} />
              )}
            </div>
            <div class="member-body">
              <h3>{m.name}</h3>
              <div class="pos">{m.role}</div>
              {m.bio && (
                <details class="bio">
                  <summary>
                    <span class="bio-open">Altro</span>
                    <span class="bio-close">Chiudi</span>
                  </summary>
                  <div class="bio-text">
                    {m.bio.map((par) => <p class:list={{ quote: par.includes('«') }}>{par}</p>)}
                  </div>
                </details>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- LA RETE: come il team si estende -->
  <section class="network">
    <div class="wrap">
      <div class="net-inner" data-reveal>
        <span class="eyebrow">Dietro ai volti</span>
        <h2>Una rete che si <em>estende</em></h2>
        <p class="net-lead">
          Il nostro valore non è solo nelle persone che incontrate: è nella
          capacità di mettervi in connessione con i professionisti giusti (fiscalisti,
          avvocati, revisori, banche d'affari, investitori) nel
          momento esatto in cui servono.
        </p>
        <p class="net-body">
          Il team si estende così: non un organico rigido, ma una squadra che si
          compone attorno alla vostra operazione. La rete è molto più ampia dei
          volti in questa pagina; a voi arriva sempre una regìa unica, che tiene
          insieme le competenze e risponde del risultato.
        </p>
      </div>
    </div>
  </section>

  <!-- SEDI: porzione di globo + gruppi per tipologia -->
  <Locations />

  <CtaBand
    lead="Un confronto riservato, senza impegno: mettiamo a fuoco insieme il valore da liberare e vi presentiamo le persone giuste."
  >
    <Fragment slot="title">Pronti a incontrare<br />i vostri <em>advisor?</em></Fragment>
  </CtaBand>
</BaseLayout>

<style>
  /* --- Team: tre schede più contenute --- */
  .team-lead { padding: 80px 0 70px; }
  .tl-head { max-width: 720px; margin-bottom: 44px; }
  .tl-head h2 {
    font-family: var(--disp); font-size: clamp(25px, calc(19.5px + 1.46vw), 40px);
    color: var(--ink); margin-top: 14px; line-height: 1.12;
  }
  .tl-head p { color: var(--muted); font-size: 18px; line-height: 1.6; margin-top: 16px; }

  .lead-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
  }
  .member {
    background: var(--panel);
    border: 1px solid var(--hair-faint);
    border-radius: var(--radius-card);
    overflow: hidden;
    transition: border-color 0.35s ease, transform 0.35s ease, box-shadow 0.35s ease;
  }
  .member:hover {
    border-color: var(--hair);
    transform: translateY(-5px);
    box-shadow: 0 18px 40px rgba(6, 27, 61, 0.08);
  }
  .member-photo { position: relative; }
  .member-photo img {
    display: block; width: 100%; aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .member-body { padding: 16px 18px 20px; }
  .member h3 { font-size: 18px; line-height: 1.25; }
  .pos {
    font-family: var(--sans); font-size: 10.5px; font-weight: 700;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--accent-text); margin-top: 7px; line-height: 1.4;
  }


  /* --- Profilo esteso: <details>, così funziona anche senza JS --- */
  .bio { margin-top: 4px; }
  .bio summary {
    list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 7px;
    font-family: var(--sans); font-size: 11px; font-weight: 700;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--accent-text);
    border-bottom: 1px solid var(--hair);
    /* il bersaglio arriva a 44px con lo spazio sopra e sotto, la riga
       sottolineata resta stretta sul testo */
    padding: 12px 0 4px;
    transition: color 0.25s ease, border-color 0.25s ease;
  }
  .bio summary::-webkit-details-marker { display: none; }
  .bio summary::after {
    content: ""; width: 7px; height: 7px; flex: none;
    border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform 0.25s ease;
  }
  .bio[open] summary::after { transform: translateY(1px) rotate(-135deg); }
  .bio summary:hover { color: var(--ink); border-color: var(--ink); }
  .bio summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .bio-close, .bio[open] .bio-open { display: none; }
  .bio[open] .bio-close { display: inline; }
  .bio-text { margin-top: 16px; max-width: 62ch; }
  .bio-text p {
    font-size: 14.5px; line-height: 1.72; color: var(--muted);
    margin-bottom: 12px;
  }
  .bio-text p:last-child { margin-bottom: 0; }
  /* La citazione chiude il profilo di chi ne ha una, e va in carattere da display */
  .bio-text p.quote {
    margin-top: 16px;
    font-family: var(--disp); font-size: 17px; line-height: 1.45;
    color: var(--ink-dim);
  }
  /* Aperta, la scheda prende due colonne e affianca ritratto e testo: una
     biografia in colonna da 240px non si legge, e il ritratto a piena
     larghezza mangerebbe lo schermo. Dove :has() non c'è, la scheda cresce. */
  .member:has(.bio[open]) {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 232px minmax(0, 1fr);
    align-items: start;
  }
  .member:has(.bio[open]) .member-body { padding: 18px 22px 24px; }

  /* --- La rete --- */
  .network {
    background: var(--panel-2);
    border-top: 1px solid var(--hair-faint);
    border-bottom: 1px solid var(--hair-faint);
    padding: 74px 0;
  }
  .net-inner { max-width: 760px; }
  .network h2 {
    font-family: var(--disp); font-size: clamp(25px, calc(18.1px + 1.85vw), 44px);
    color: var(--ink); margin-top: 14px; line-height: 1.12;
  }
  .network h2 :global(em) { font-style: normal; color: var(--accent-text); }
  .net-lead { font-size: clamp(16.5px, calc(14.5px + 0.54vw), 22px); color: var(--ink-dim); line-height: 1.55; margin-top: 20px; }
  .net-body { font-size: 17px; color: var(--muted); line-height: 1.7; margin-top: 18px; }

  @media (max-width: 1040px) {
    .lead-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 860px) {
    /* ritratto e biografia in colonna: affiancati resterebbero 110px di testo */
    .member:has(.bio[open]) { grid-template-columns: 1fr; }
    .member:has(.bio[open]) .member-photo { max-width: 260px; }
  }
  @media (max-width: 720px) {
    .lead-grid { grid-template-columns: 1fr 1fr; gap: 16px; }
  }

  @media (max-width: 560px) {
    .tl-head p { font-size: 16.5px; }
    .net-body { font-size: 16.5px; }
    .lead-grid { gap: 14px; }
    .member-body { padding: 14px 14px 18px; }
    .member h3 { font-size: 16.5px; }
    .pos { font-size: 10px; letter-spacing: 0.1em; }
    .bio-text p { font-size: 15px; }
  }
</style>
