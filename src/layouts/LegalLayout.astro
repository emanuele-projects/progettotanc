---
/**
 * Impaginazione delle pagine legali (privacy, cookie): testata compatta e
 * colonna di lettura stretta. Gli stili del corpo sono qui una volta sola.
 */
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { legal } from '../data/site';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  lead: string;
}
const { title, description, eyebrow, lead } = Astro.props;
---

<BaseLayout theme="light" title={`${title} · Fulvio Rossi Plus`} description={description}>
  <PageHero eyebrow={eyebrow} art="editorial" lead={lead}>
    {title}
  </PageHero>

  <section class="legal">
    <div class="wrap">
      <div class="legal-body" data-reveal>
        <slot />
        <p class="legal-updated">Ultimo aggiornamento: {legal.updated}</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .legal { padding: 70px 0 100px; }
  .legal-body { max-width: 760px; }

  .legal-body :global(h2) {
    font-family: var(--disp); font-size: clamp(21px, calc(17.7px + 0.88vw), 30px);
    color: var(--ink); line-height: 1.2;
    margin: 52px 0 16px;
    padding-top: 26px; border-top: 1px solid var(--hair-faint);
  }
  .legal-body :global(h2:first-child) { margin-top: 0; padding-top: 0; border-top: none; }
  .legal-body :global(h3) {
    font-family: var(--disp); font-size: 19px; color: var(--ink);
    margin: 30px 0 10px;
  }
  .legal-body :global(p) {
    font-size: 17px; line-height: 1.75; color: var(--muted); margin-bottom: 16px;
  }
  .legal-body :global(ul) { list-style: none; margin: 0 0 18px; }
  .legal-body :global(li) {
    position: relative; padding-left: 24px;
    font-size: 16.5px; line-height: 1.7; color: var(--muted); margin-bottom: 10px;
  }
  .legal-body :global(li)::before {
    content: "·"; position: absolute; left: 0; color: var(--accent-text);
  }
  .legal-body :global(strong) { color: var(--ink); font-weight: 700; }
  .legal-body :global(a) { color: var(--accent-text); border-bottom: 1px solid var(--hair); }

  /* Segnaposto dei dati ancora mancanti: devono saltare all'occhio in bozza */
  .legal-body :global(.todo) {
    background: var(--panel-2);
    border-bottom: 1px dashed var(--accent);
    padding: 1px 6px; border-radius: 3px;
    font-family: var(--sans); font-size: 0.92em; color: var(--ink);
  }

  .legal-body :global(table) {
    width: 100%; border-collapse: collapse; margin: 18px 0 26px;
    font-size: 15.5px;
  }
  .legal-body :global(th), .legal-body :global(td) {
    text-align: left; vertical-align: top;
    padding: 11px 12px 11px 0;
    border-bottom: 1px solid var(--hair-faint);
    color: var(--muted); line-height: 1.55;
  }
  .legal-body :global(th) {
    font-family: var(--sans); font-size: 11.5px; font-weight: 700;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent-text);
  }

  .legal-updated {
    margin-top: 48px; padding-top: 22px;
    border-top: 1px solid var(--hair-faint);
    font-family: var(--sans); font-size: 12px !important;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted-2) !important;
  }

  .legal-body :global(.table-scroll) { overflow-x: auto; }

  @media (max-width: 560px) {
    /* Sotto i 560px il contenitore scende a ~335px: parole senza spazi come
       «CONSERVAZIONE» o «indicativamente» imponevano una larghezza minima
       di colonna che il layout automatico non poteva rispettare, e
       overflow-x:auto nascondeva il resto senza nessun indizio che si
       potesse scorrere — sembrava testo troncato per errore. table-layout
       fixed forza colonne di larghezza fissa e break-word le fa andare a
       capo, così tutto il contenuto resta visibile senza scorrimento. */
    .legal-body :global(table) { table-layout: fixed; font-size: 12.5px; }
    .legal-body :global(th), .legal-body :global(td) {
      padding: 8px 6px 8px 0;
      overflow-wrap: break-word; word-break: break-word;
    }
    .legal-body :global(th) { font-size: 9.5px; letter-spacing: 0.05em; }
  }
</style>
