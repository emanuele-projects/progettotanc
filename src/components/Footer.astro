---
import Logo from './Logo.astro';
import { site, nav } from '../data/site';
import { locations, typeLabels } from '../data/locations';
import { url } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="on-navy">
  <div class="wrap">
    <div class="foot-seal">
      <div class="emblem-seal" aria-hidden="true"></div>
    </div>
    <div class="foot-top">
      <div class="foot-brand">
        <Logo variant="lockup" class="foot-mark" height={150} />
      </div>
      <div class="foot-col">
        <h4>Studio</h4>
        <p>
          {nav.map((item) => <a href={url(item.href)}>{item.label}<br /></a>)}
        </p>
      </div>
      <div class="foot-col">
        <h4>Contatti</h4>
        <p>
          <a href={`mailto:${site.email}`}>{site.email}</a><br />
          {site.address}
        </p>
        <ul class="foot-phones">
          {site.phones.map((p) => (
            <li>
              <span class="fp-area">{p.area}</span>
              <a href={`tel:${p.tel}`}>{p.number}</a>
            </li>
          ))}
        </ul>
      </div>
      <div class="foot-col">
        <h4>Sedi</h4>
        <ul class="foot-sedi">
          {locations.map((l) => (
            <li>
              <span class="fs-city">{l.city}<i>{l.cc}</i></span>
              <span class="fs-role">{typeLabels[l.type]}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© {year}. Tutti i diritti riservati</span>
      <nav class="foot-legal" aria-label="Informative">
        <a href={url('/privacy/')}>Privacy</a>
        <a href={url('/cookie/')}>Cookie</a>
      </nav>
      <span>{site.piva}</span>
    </div>
  </div>
</footer>

<style>
  /* Footer sempre navy (alla CookGroup), con il rombo come sigillo */
  footer {
    background: linear-gradient(180deg, var(--navy) 0%, var(--navy-2) 100%);
    color: var(--on-navy-dim);
    padding: 56px 0 36px;
  }
  .foot-seal {
    display: flex; justify-content: center;
    padding-bottom: 36px;
  }
  .foot-top {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 40px;
    padding-bottom: 44px;
    border-bottom: 1px solid var(--hair-on-navy);
  }
  .foot-brand { display: flex; flex-direction: column; align-items: flex-start; }
  .foot-brand :global(.foot-mark) { flex: none; color: var(--on-navy); }
  .foot-col h4 {
    font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--accent-soft);
    margin-bottom: 16px;
  }
  .foot-col p { font-size: 16px; line-height: 1.9; font-weight: 300; }
  /* Sedi: stessa gerarchia della pagina Team & Sedi, città con la sigla del
     paese e sotto il ruolo della sede */
  .foot-sedi { list-style: none; }
  .foot-sedi li { margin-bottom: 12px; }
  .foot-sedi .fs-city {
    display: block; font-size: 16px; font-weight: 400; color: var(--on-navy);
  }
  .foot-sedi .fs-city i {
    font-style: normal; font-family: var(--sans);
    font-size: 10px; font-weight: 700; letter-spacing: 0.14em;
    color: var(--on-navy-muted); margin-left: 8px; vertical-align: 1px;
  }
  .foot-sedi .fs-role {
    display: block; font-family: var(--sans);
    font-size: 10px; font-weight: 600; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--accent-soft); margin-top: 2px;
  }
  .foot-col a { transition: color 0.3s; }
  .foot-col a:hover { color: var(--accent-soft); }
  .foot-phones { list-style: none; margin-top: 14px; }
  .foot-phones li { margin-bottom: 8px; }
  .foot-phones .fp-area {
    display: block;
    font-family: var(--sans); font-size: 9.5px; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--on-navy-muted);
  }
  .foot-phones a { font-size: 16px; }
  .foot-phones a:hover { color: var(--accent-soft); }

  .foot-legal { display: flex; gap: 20px; }
  .foot-legal a { transition: color 0.3s; }
  .foot-legal a:hover { color: var(--accent-soft); }
  .foot-bottom {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px;
    padding-top: 26px;
    font-family: var(--sans); font-size: 12px; font-weight: 500; letter-spacing: 0.08em;
    color: var(--on-navy-muted); text-transform: uppercase;
  }

  @media (max-width: 560px) {
    /* il marchio intero a 150px prende metà schermo */
    .foot-brand :global(.foot-mark) { width: 158px !important; height: 110px !important; }
    /* bersagli da dito: prima ogni voce era alta 19px */
    .foot-phones a, .foot-legal a { display: inline-block; padding: 10px 0; }
    /* le voci di menu portano un <br> dentro l'anchor: da inline-block il
       ritorno a capo sparisce e i nomi si attaccano. Qui vanno a blocco. */
    .foot-col p a { display: block; width: fit-content; padding: 8px 0; }
    .foot-col p a br { display: none; }
    .foot-phones li { margin-bottom: 2px; }
    .foot-col p { line-height: 1.5; }
    .foot-col h4 { margin-bottom: 10px; }
  }
</style>
