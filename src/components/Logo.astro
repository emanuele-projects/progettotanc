---
/**
 * Marchio Fulviorossi Plus, nelle sue declinazioni.
 *
 * Il file fornito è un PNG a tinta piena su fondo bianco: qui viene usato
 * come **maschera CSS**, non come immagine. Il colore arriva da `currentColor`,
 * quindi il marchio segue il contesto: bianco sull'header trasparente sopra
 * l'hero, blu di brand sull'header bianco dopo lo scroll, bianco nel footer.
 * Il tondo «PLUS» resta cavo, perché le lettere bianche dentro il cerchio
 * diventano fori nella maschera.
 *
 * Ogni variante è un **ritaglio unico** del disegno originale, mai una
 * ricomposizione: così le proporzioni fra gli elementi restano quelle
 * disegnate. Nel marchio il lettering è alto il 38% della colonna, il che
 * rende impossibile affiancarli in una fascia da 40px senza falsare il
 * rapporto o rendere illeggibile il nome. Da qui la scelta delle varianti.
 *
 * `lockup`    il marchio intero. Vuole spazio: il payoff vale il 5%
 *             dell'altezza, sotto i ~140px non si legge. Sta nel footer.
 * `lettering` «Fulviorossi» e il tondo PLUS: è il marchio dell'header, dove
 *             servono trenta pixel di altezza e un nome leggibile.
 * `simbolo`   la sola colonna, per favicon e spazi stretti.
 */
import { url } from '../lib/url';

interface Props {
  variant?: 'lockup' | 'lettering' | 'simbolo';
  /** Altezza resa; le larghezze seguono le proporzioni del disegno */
  height?: number;
  class?: string;
}
const { variant = 'lockup', height = 40, class: className } = Astro.props;

const ART = {
  lockup: { src: '/logo-lockup.png', w: 1600, h: 1118 },
  lettering: { src: '/logo-testo.png', w: 1200, h: 353 },
  simbolo: { src: '/logo-simbolo.png', w: 600, h: 800 },
};
const a = ART[variant];
const u = url(a.src);

const label = 'Fulviorossi Plus · Deep Consulting & Mentoria';
---

<span
  class:list={['logo', 'logo-mark', className]}
  role="img"
  aria-label={label}
  style={`width:${Math.round((a.w / a.h) * height)}px;height:${height}px;` +
    `-webkit-mask-image:url('${u}');mask-image:url('${u}')`}
></span>

<style>
  .logo-mark {
    display: block;
    background-color: currentColor;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-position: center;
    mask-position: center;
  }
</style>
