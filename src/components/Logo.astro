---
/**
 * Marchio Fulviorossi Plus, nelle sue declinazioni.
 *
 * Il file fornito è un PNG a tinta piena su fondo bianco: qui viene usato
 * come **maschera CSS**, non come immagine. Il colore arriva da `currentColor`,
 * quindi il marchio segue il contesto: bianco sull'header trasparente sopra
 * l'hero, blu di brand sull'header bianco dopo lo scroll, bianco nel footer,
 * senza mantenere due file per i due fondi. Il tondo «PLUS» resta cavo,
 * perché le lettere bianche dentro il cerchio diventano fori nella maschera.
 *
 * `lockup`   il marchio intero, colonna + lettering + payoff. Nel disegno
 *            nuovo è quasi quadrato e il payoff vale il 5% dell'altezza:
 *            sotto i ~160px non si legge. In pagina non lo usiamo, il payoff
 *            viaggia come testo vero (vedi Footer.astro).
 * `compatto` colonna e «Fulviorossi PLUS» affiancati, alla stessa altezza:
 *            è la resa orizzontale, quella che sta in header e footer.
 * `simbolo`  la sola colonna, per gli spazi stretti.
 */
import { url } from '../lib/url';

interface Props {
  variant?: 'lockup' | 'compatto' | 'simbolo';
  /** Altezza resa; le larghezze seguono le proporzioni */
  height?: number;
  class?: string;
}
const { variant = 'compatto', height = 40, class: className } = Astro.props;

const ART = {
  lockup: { src: '/logo-lockup.png', w: 1600, h: 1118 },
  simbolo: { src: '/logo-simbolo.png', w: 600, h: 800 },
  testo: { src: '/logo-testo.png', w: 1200, h: 351 },
};

const mask = (a: { src: string }) => {
  const u = url(a.src);
  return `-webkit-mask-image:url('${u}');mask-image:url('${u}')`;
};
const box = (a: { w: number; h: number }, hh: number) =>
  `width:${Math.round((a.w / a.h) * hh)}px;height:${hh}px`;

const label = 'Fulviorossi Plus · Deep Consulting & Mentoria';
---

{variant === 'compatto' ? (
  <span
    class:list={['logo', 'logo-compatto', className]}
    role="img"
    aria-label={label}
    style={`--logo-gap:${Math.round(height * 0.34)}px`}
  >
    <span class="logo-mark" style={`${box(ART.simbolo, height)};${mask(ART.simbolo)}`}></span>
    <span class="logo-mark" style={`${box(ART.testo, height)};${mask(ART.testo)}`}></span>
  </span>
) : (
  <span
    class:list={['logo', 'logo-mark', className]}
    role="img"
    aria-label={label}
    style={`${box(variant === 'simbolo' ? ART.simbolo : ART.lockup, height)};${mask(
      variant === 'simbolo' ? ART.simbolo : ART.lockup
    )}`}
  ></span>
)}

<style>
  .logo-mark {
    display: block;
    background-color: currentColor;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-position: center;
    mask-position: center;
  }
  .logo-compatto {
    display: flex;
    align-items: center;
    gap: var(--logo-gap, 12px);
  }
</style>
