---
/**
 * Marchio Fulviorossi Plus, nelle sue declinazioni.
 *
 * Il file fornito è un JPEG a tinta piena su fondo bianco: qui viene usato
 * come **maschera CSS**, non come immagine. Il colore arriva da `currentColor`,
 * quindi il marchio segue il contesto — bianco sull'header trasparente sopra
 * l'hero, blu di brand sull'header bianco dopo lo scroll, bianco nel footer —
 * senza mantenere due file per i due fondi.
 *
 * `lockup`   colonna + lettering + payoff. Vuole spazio: sotto i ~90px di
 *            altezza il payoff non si legge, quindi sta nel footer.
 * `compatto` colonna + «Fulviorossi PLUS», senza payoff: è la resa per
 *            l'header, dove l'altezza utile è una quarantina di pixel.
 * `simbolo`  la sola colonna, per gli spazi stretti.
 */
import { url } from '../lib/url';

interface Props {
  variant?: 'lockup' | 'compatto' | 'simbolo';
  /** Altezza resa; le larghezze seguono le proporzioni */
  height?: number;
  class?: string;
}
const { variant = 'lockup', height = 40, class: className } = Astro.props;

const ART = {
  lockup: { src: '/logo-lockup.png', w: 1184, h: 469 },
  simbolo: { src: '/logo-simbolo.png', w: 352, h: 469 },
  testo: { src: '/logo-testo.png', w: 743, h: 66 },
};

const mask = (a: { src: string }) => {
  const u = url(a.src);
  return `-webkit-mask-image:url('${u}');mask-image:url('${u}')`;
};
const box = (a: { w: number; h: number }, hh: number) =>
  `width:${Math.round((a.w / a.h) * hh)}px;height:${hh}px`;

const label = 'Fulviorossi Plus · Deep Consulting & Mentoria';
---

{variant === 'compatto' ? (
  <span class:list={['logo', 'logo-compatto', className]} role="img" aria-label={label}>
    <span class="logo-mark" style={`${box(ART.simbolo, height)};${mask(ART.simbolo)}`}></span>
    <span
      class="logo-mark"
      style={`${box(ART.testo, Math.round(height * 0.45))};${mask(ART.testo)}`}
    ></span>
  </span>
) : (
  <span
    class:list={['logo', 'logo-mark', className]}
    role="img"
    aria-label={label}
    style={`${box(variant === 'simbolo' ? ART.simbolo : ART.lockup, height)};${mask(
      variant === 'simbolo' ? ART.simbolo : ART.lockup
    )}`}
  ></span>
)}

<style>
  .logo-mark {
    display: block;
    background-color: currentColor;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-position: center;
    mask-position: center;
  }
  .logo-compatto {
    display: flex;
    align-items: center;
    gap: 0.32em;
  }
</style>
