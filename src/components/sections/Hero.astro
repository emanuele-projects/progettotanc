---
/**
 * Hero alla CookGroup: banda a tutta larghezza con sfondo (video, foto
 * o illustrazione) + overlay navy e testo bianco.
 */
import BrandArt from '../BrandArt.astro';
import { url } from '../../lib/url';

interface Cta {
  label: string;
  href: string;
  solid?: boolean;
}
interface Meta {
  /** Cifra in evidenza; se assente resta la sola formula testuale */
  value?: string;
  label: string;
}
interface Props {
  eyebrow: string;
  lead: string;
  ctas?: Cta[];
  meta?: Meta[];
  photo?: string;
  art?: 'skyline' | 'boardroom' | 'mentoria' | 'deal' | 'growth';
  /** Sfondo video (percorso in /public). Prevale su photo/art. */
  video?: string;
  /** object-position del video (default 'center') */
  videoPosition?: string;
  /** Punto da tenere in inquadratura per la foto di sfondo */
  focus?: string;
  /**
   * Ritratto affiancato al testo, invece che sfondo a tutta larghezza:
   * il testo resta a sinistra e la foto occupa la colonna di destra.
   */
  sidePhoto?: string;
  sidePhotoAlt?: string;
  sidePhotoFocus?: string;
}
const {
  eyebrow,
  lead,
  ctas = [],
  meta = [],
  photo,
  art,
  video,
  videoPosition = 'center',
  focus = '50% 50%',
  sidePhoto,
  sidePhotoAlt = '',
  sidePhotoFocus = '50% 50%',
} = Astro.props;
---

<section class="hero on-navy" id="top">
  {video && (
    <video
      class="hero-video"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      src={url(video)}
      style={`object-position:${videoPosition}`}
      aria-hidden="true"
    ></video>
  )}

  {!video && photo && (
    <div
      class="hero-photo"
      style={`background-image:url('${url(photo)}');background-position:${focus}`}
      aria-hidden="true"
    ></div>
  )}

  {!video && !photo && art && (
    <div class="hero-art" aria-hidden="true">
      <BrandArt variant={art} />
    </div>
  )}

  <div class="hero-overlay" aria-hidden="true"></div>

  {!video && !photo && !art && (
    <div class="deco" aria-hidden="true">
      <div class="emblem"></div>
    </div>
  )}

  <div class:list={['wrap', { 'hero-split': sidePhoto }]}>
    <div class="hero-inner em-gold">
      <span class="eyebrow" data-reveal>{eyebrow}</span>
      <h1 data-reveal><slot name="title" /></h1>
      <p class="lead" data-reveal>{lead}</p>
      {ctas.length > 0 && (
        <div class="hero-cta" data-reveal>
          {ctas.map((cta) => (
            <a href={url(cta.href)} class:list={['btn', { 'btn-solid': cta.solid }]}>{cta.label}</a>
          ))}
        </div>
      )}
      {meta.length > 0 && (
        <div class="hero-meta" data-reveal>
          {meta.map((m) => {
            const match = m.value?.match(/^(\d+)(.*)$/);
            return (
              <span class:list={{ 'no-value': !m.value }}>
                {m.value && (match ? (
                  <b data-countup={match[1]} data-suffix={match[2]}>{m.value}</b>
                ) : (
                  <b>{m.value}</b>
                ))}
                {m.label}
              </span>
            );
          })}
        </div>
      )}
    </div>

    {sidePhoto && (
      <figure class="hero-side" data-reveal>
        <img src={url(sidePhoto)} alt={sidePhotoAlt} style={`object-position:${sidePhotoFocus}`} />
      </figure>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 88vh;
    display: flex; align-items: center;
    padding: 150px 0 90px;
    background: linear-gradient(160deg, var(--navy) 0%, var(--navy-2) 100%);
    color: var(--on-navy);
    overflow: hidden;
  }
  .hero-video {
    position: absolute; inset: 0; z-index: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .hero-photo {
    position: absolute; inset: 0; z-index: 0;
    background-size: cover; background-position: center;
  }
  .hero-art { position: absolute; inset: 0; z-index: 0; opacity: 0.5; }
  .hero-art[hidden] { display: none; }
  .hero-art :global(.brand-art) { height: 100%; aspect-ratio: auto; background: transparent; }
  .hero-overlay {
    position: absolute; inset: 0; z-index: 0;
    background: var(--navy-overlay);
  }
  .hero .wrap { width: 100%; }
  .hero-inner { max-width: 860px; }

  /* Ritratto affiancato: testo a sinistra, foto contenuta a destra */
  .hero-split {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: 60px;
    align-items: center;
  }
  .hero-split .hero-inner { max-width: none; }
  .hero-side {
    margin: 0;
    border-radius: var(--radius-card);
    overflow: hidden;
    border: 1px solid var(--hair-on-navy);
    box-shadow: 0 24px 60px rgba(3, 12, 30, 0.45);
  }
  .hero-side img {
    display: block; width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: saturate(0.85) contrast(1.02);
  }
  .hero :global(.eyebrow) { color: var(--accent-soft); }
  .hero h1 {
    font-size: clamp(32px, calc(15.2px + 4.49vw), 78px);
    font-weight: 800;
    color: var(--on-navy);
    margin: 26px 0 0;
    line-height: 1.08;
  }
  .lead {
    font-size: clamp(17px, calc(14.8px + 0.59vw), 23px);
    font-weight: 300;
    color: var(--on-navy-dim);
    max-width: 640px;
    margin: 28px 0 0;
    line-height: 1.6;
  }
  .hero-cta { display: flex; gap: 16px; margin-top: 42px; flex-wrap: wrap; }
  .hero-meta {
    display: flex; gap: 44px; margin-top: 60px; flex-wrap: wrap;
    font-family: var(--sans); font-size: 12px; font-weight: 600;
    letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--on-navy-muted);
    border-top: 1px solid var(--hair-on-navy);
    padding-top: 24px; max-width: 720px;
  }
  /* Voce senza cifra: allineata alle altre, con lo stesso peso ottico */
  .hero-meta span.no-value {
    align-self: center;
    max-width: 220px;
    color: var(--accent-soft);
    text-transform: none;
    font-family: var(--disp); font-size: 17px; font-weight: 400;
    letter-spacing: 0; line-height: 1.35;
  }
  .hero-meta span b {
    color: var(--accent-soft); font-weight: 700; display: block;
    font-family: var(--disp); font-size: clamp(25px, calc(23.2px + 0.49vw), 30px); letter-spacing: 0;
    margin-bottom: 4px; text-transform: none;
  }

  @media (max-width: 900px) {
    .hero { min-height: 0; padding: 132px 0 64px; }
    .hero-split { grid-template-columns: 1fr; gap: 38px; }
    .hero-side { max-width: 320px; }
    .hero-side img { aspect-ratio: 4 / 3; }
  }

  @media (max-width: 560px) {
    .hero { padding: 112px 0 48px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video { display: none; }
  }
</style>

